---
import Base from '../layouts/Base.astro';
import pubs from '../data/publications.json';
---
<Base title="Publications" description="Publications by Chandranathan Anandavijayan on magnetically dominated turbulence, reconnection, and holographic entanglement entropy.">
  <h1>Publications</h1>
  <ul class="plain">
    {pubs.map((p) => (
      <li>
        <span class="date">{p.year}</span>
        <a href={p.url}>{p.title}</a><br />
        <span class="meta">{p.authors}. <em>{p.venue}</em></span>
      </li>
    ))}
  </ul>
</Base>
